# Local compose starts with keyless demo data; add keys to ingest live sources.
DATABASE_URL=postgresql+psycopg://saans:saans_local@db:5432/saans

# Live feeds (optional)
OPENAQ_API_KEY=
FIRMS_MAP_KEY=

# Protect internal scheduled jobs. Generate a long random value for deployments.
INGEST_TOKEN=replace-with-a-long-random-secret

# Telegram alert sending (optional). The bot must be started by the recipient.
TELEGRAM_BOT_TOKEN=

# Web Push (optional). Generate VAPID keys and use the public key in the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# CORS allow-list. Local compose serves UI and API on one origin.
ALLOWED_ORIGIN=http://localhost:8000
PORT=8000
